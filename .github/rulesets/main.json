{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "squash",
          "merge",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Générateur"
          },
          {
            "context": "collection (ansible-core >=2.17,<2.18)"
          },
          {
            "context": "collection (ansible-core >=2.18,<2.19)"
          },
          {
            "context": "collection (ansible-core >=2.19,<2.20)"
          },
          {
            "context": "collection (ansible-core >=2.20,<2.21)"
          },
          {
            "context": "Archive"
          },
          {
            "context": "Intégration"
          },
          {
            "context": "Actionlint (syntaxe des workflows)"
          },
          {
            "context": "Zizmor (analyse statique des workflows)"
          },
          {
            "context": "Poutine (chaînes d'exploitation CI/CD)"
          },
          {
            "context": "La protection de branche est celle qui est déclarée"
          },
          {
            "context": "Analyser Python"
          },
          {
            "context": "Revoir les changements de dépendances"
          },
          {
            "context": "TruffleHog"
          }
        ]
      }
    }
  ]
}
